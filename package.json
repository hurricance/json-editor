{
  "name": "chrome-json-editor",
  "version": "1.0.0",
  "description": "Chrome extension: two-panel JSON editor with recursive formatting",
  "scripts": {
    "build": "esbuild src/background.ts src/editor.ts --bundle --outdir=dist --format=iife",
    "typecheck": "tsc --noEmit",
    "watch": "esbuild src/background.ts src/editor.ts --bundle --outdir=dist --format=iife --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  }
}
